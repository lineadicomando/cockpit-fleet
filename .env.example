# Settings of the test VMs that belong to one workstation (test/vm/, skill
# vm-lab). Copy to .env, which is not tracked, and fill it in. One KEY=value
# per line, no quotes: the value is everything after "=".
# Any variable of test/vm/lab.conf may be overridden here too (a subnet that
# is free on this host, another libvirt pool, the language of the ISO).

# Password of the admin account (LAB_USER, "maint") on every VM. Windows
# wants upper and lower case letters and digits.
LAB_PASSWORD=

# Windows 11 Enterprise Evaluation ISO, downloaded from Microsoft's
# Evaluation Center (www.microsoft.com/evalcenter); readable by libvirt.
# Evaluation use only, for 90 days: rebuild the VM when it expires.
WIN_ISO=
# Language of that ISO and keyboard layout, e.g. it-IT and 0410:00000410.
#WIN_LANG=en-US
#WIN_KEYBOARD=0409:00000409
