#!/usr/bin/make -f

%:
	dh $@ --with installsysusers

# The bundle is built beforehand with npm (make build): the package build has
# no network access and only packs the result.
override_dh_auto_clean:

override_dh_auto_build:
	test -f dist/index.js || { echo "dist/ is missing: run 'make build' first"; exit 1; }

override_dh_auto_test:

# The screenshots are for the README on the web, the decisions and the
# history for those who work on the project, not for /usr/share/doc: the
# documents installed link to them, and to TODO.md, in the repository.
override_dh_installdocs:
	dh_installdocs -Xscreenshots -Xdecisions.md -Xhistory

# CHANGELOG.md after the Debian changelog, by its own name: found earlier,
# dh_installchangelogs would make it the changelog, in place of the Debian
# one a native package must have.
override_dh_installchangelogs:
	dh_installchangelogs
	install -m 0644 CHANGELOG.md debian/cockpit-fleet/usr/share/doc/cockpit-fleet/

override_dh_auto_install:
	$(MAKE) install-files DESTDIR=$(CURDIR)/debian/cockpit-fleet

# Only the timer and the path unit are enabled and started; their services
# run when they say.
override_dh_installsystemd:
	dh_installsystemd cockpit-fleet-scheduler.timer cockpit-fleet-notify.path
