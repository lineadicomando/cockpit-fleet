#!/usr/bin/python3 -I
"""Execute one job inside cockpit-fleet-run@ID.service.

Writes the human-readable output to stdout.log and to the journal, and the
outcome to result.json, which is what the backend reads once the unit is gone.
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, "/usr/lib/cockpit-fleet")

from cockpit_fleet import archive, copier, fetch, runner  # noqa: E402
from cockpit_fleet.errors import FleetError  # noqa: E402
from cockpit_fleet.names import check_id  # noqa: E402
from cockpit_fleet.paths import RUNS_DIR  # noqa: E402

current: subprocess.Popen | None = None
terminated = False
# The decrypted secrets of this run: masked in everything it prints.
secrets: list[bytes] = []


def on_term(signum, frame):
    global terminated
    terminated = True
    if current is not None and current.poll() is None:
        current.terminate()


def execute(command: list[str], env: dict, cwd: Path, log) -> int:
    """Run one command, copying its output to the log and to the journal."""
    global current
    current = subprocess.Popen(
        command, env=env, cwd=cwd,
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    for line in current.stdout:
        line = runner.mask(line, secrets)
        log.write(line)
        log.flush()
        sys.stdout.buffer.write(line)
        sys.stdout.buffer.flush()
    return current.wait()


def start_agent(credentials: Path | None, runtime_dir: Path, prefix: str, log) -> str | None:
    """Load a passphrase-protected key into an agent; returns the agent socket.

    The agent lives in the unit's own PID namespace and dies with it.
    """
    if not runner.needs_agent(credentials, prefix):
        return None
    agent, add, env, socket = runner.agent_plan(credentials, runtime_dir, prefix)
    subprocess.Popen(agent, env={"PATH": "/usr/bin:/bin"}, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        if os.path.exists(socket):
            break
        time.sleep(0.1)
    if execute(add, env, runtime_dir, log) != 0:
        raise ValueError("the SSH key could not be unlocked: wrong passphrase?")
    return socket


def run_job(spec: dict, run_dir: Path, runtime_dir: Path, credentials: Path | None, log) -> dict:
    kind = spec.get("kind", "playbook")
    if kind == "sync":
        commands, env = runner.build_sync(spec, run_dir, runtime_dir, credentials)
        socket = start_agent(credentials, runtime_dir, "git_", log)
        if socket:
            env["SSH_AUTH_SOCK"] = socket
        for command in commands:
            rc = execute(command, env, run_dir, log)
            if rc != 0:
                return {"rc": rc}
        checkout = run_dir / "checkout"
        revision = subprocess.run(
            ["/usr/bin/git", "-C", str(checkout), "rev-parse", "HEAD"],
            env=env, capture_output=True, text=True, check=True,
        ).stdout.strip()
        # Only the files are kept: nothing outside the sandbox runs git on them.
        shutil.rmtree(checkout / ".git")
        return {"rc": 0, "revision": revision}

    if kind == "unpack":
        done = archive.extract(run_dir / "archive", run_dir / "checkout")
        lines = [f"{done['files']} files, {done['links']} links, {done['bytes']} bytes"]
        if done["stripped"]:
            lines.append(f"the content of {done['stripped']}/ is the project")
        if done["skipped"]:
            lines.append(f"{done['skipped']} members left out (git's own)")
        text = "".join(line + "\n" for line in lines).encode()
        log.write(text)
        sys.stdout.buffer.write(text)
        return {"rc": 0, **done}

    if kind in ("download", "copy"):
        def say(text: str) -> None:
            line = f"{text}\n".encode(errors="replace")
            log.write(line)
            log.flush()
            sys.stdout.buffer.write(line)
            sys.stdout.buffer.flush()
        if kind == "copy":
            return copier.copy(spec, run_dir, say, lambda: terminated)
        return fetch.download(spec, run_dir, say, lambda: terminated)

    if kind == "galaxy":
        command, env = runner.build_galaxy(spec, run_dir, runtime_dir)
        return {"rc": execute(command, env, run_dir / "project", log)}

    if kind == "syntax" and "inventory" in spec:
        # An inventory: read as for an "inventory" job, strictly, with its vault.
        env = runner.build_env(run_dir, runtime_dir, events=False, credentials_dir=credentials)
        env.update(runner.INVENTORY_SYNTAX_ENV)
        return {"rc": execute(runner.build_inventory_argv(spec, run_dir, credentials), env,
                              run_dir / "project", log)}

    if kind == "syntax":
        env = runner.build_env(run_dir, runtime_dir, events=False)
        result = {"rc": execute(runner.build_syntax_argv(spec, run_dir), env,
                                run_dir / "project", log)}
        if result["rc"] == 0 and os.path.exists(runner.LINT):
            # What ansible-lint finds is reported, it does not fail the check.
            result["lint_rc"] = execute(runner.build_lint_argv(spec, run_dir), env,
                                        run_dir / "project", log)
        return result

    env = runner.build_env(run_dir, runtime_dir, scripts=spec.get("inventory_scripts") is True,
                           credentials_dir=credentials)
    socket = start_agent(credentials, runtime_dir, "", log)
    if socket:
        env["SSH_AUTH_SOCK"] = socket
    if kind == "inventory":
        command = runner.build_inventory_argv(spec, run_dir, credentials)
    elif kind == "playbook":
        limit_file = None
        plan = runner.limit_plan(spec, run_dir, runtime_dir, credentials)
        if plan:
            listings = []
            for command, output in plan:
                rc = execute(command, env, run_dir / "project", log)
                if rc != 0:
                    return {"rc": rc}
                listings.append(json.loads(output.read_text()))
            limit_file = runtime_dir / "limit"
            limit_file.write_text(runner.limit_hosts(listings))
        command = runner.build_argv(spec, run_dir, runtime_dir, credentials, limit_file)
    elif kind == "adhoc":
        command = runner.build_adhoc_argv(spec, run_dir, runtime_dir, credentials)
        env.update(runner.ADHOC_ENV)
    elif kind == "check":
        command = runner.build_check_argv(spec, run_dir, runtime_dir, credentials)
        env.update(runner.check_env(spec))
    else:
        raise ValueError(f"unknown job kind: {kind!r}")
    return {"rc": execute(command, env, run_dir / "project", log)}


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: fleet-run RUN_ID", file=sys.stderr)
        return 2
    signal.signal(signal.SIGTERM, on_term)
    try:
        run_id = check_id(argv[1], "run id")
        run_dir = RUNS_DIR / run_id
        runtime_dir = Path(os.environ["RUNTIME_DIRECTORY"])
        credentials = os.environ.get("CREDENTIALS_DIRECTORY")
        spec = json.loads((run_dir / "spec.json").read_text())
        if not isinstance(spec, dict):
            raise ValueError("spec.json must contain an object")
    except (ValueError, KeyError, OSError) as error:
        print(f"fleet-run: {error}", file=sys.stderr)
        return 2

    with open(run_dir / "stdout.log", "ab") as log:
        try:
            credentials_dir = Path(credentials) if credentials else None
            secrets[:] = runner.secret_values(credentials_dir)
            result = run_job(spec, run_dir, runtime_dir, credentials_dir, log)
        except (FleetError, ValueError, OSError, subprocess.SubprocessError) as error:
            message = runner.mask(f"fleet-run: {error}\n".encode(), secrets)
            log.write(message)
            sys.stdout.buffer.write(message)
            result = {"rc": 2, "error": str(error)}

    result["finished_at"] = time.time()
    # Read last, once every command has ended: the planner sizes check cycles on it.
    result["usage"] = runner.usage()
    result["terminated"] = terminated
    temporary = run_dir / "result.json.tmp"
    temporary.write_text(json.dumps(result))
    temporary.replace(run_dir / "result.json")
    if spec.get("kind") == "check" and result["rc"] in runner.CHECK_RCS:
        # The cycle ran: a host that failed is in its states, not in the unit's.
        return 0
    return 0 if result["rc"] == 0 else (result["rc"] if 0 < result["rc"] < 256 else 1)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
