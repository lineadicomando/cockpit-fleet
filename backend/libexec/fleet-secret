#!/usr/bin/python3 -I
"""Store, delete and list encrypted secrets. Runs as root.

Values are read from stdin and encrypted with systemd-creds (host key, plus
TPM2 when available). There is no command to read a value back: only PID 1 can
decrypt, and it does so for a run unit through LoadCredentialEncrypted=.

"answer" is the one thing an operator may ask for: it stores a secret answer
to a survey under a name chosen here, and prints that name. The caller picks
no name, so it can overwrite nothing; the run it is launched with takes the
file away.
"""

import os
import secrets
import subprocess
import sys

sys.path.insert(0, "/usr/lib/cockpit-fleet")

from cockpit_fleet import journal  # noqa: E402
from cockpit_fleet.names import check_id  # noqa: E402
from cockpit_fleet.paths import ANSWERS_DIR, SECRETS_DIR  # noqa: E402

MAX_SIZE = 64 * 1024
MAX_ANSWER_SIZE = 4096
# Answers waiting for their run. More than this is not somebody launching runs.
MAX_ANSWERS = 500
SUFFIX = ".cred"


def log(action: str, name: str) -> None:
    # The value never gets here; only who touched which secret.
    user = os.environ.get("SUDO_USER", "root")
    journal.send(f"{user} secret.{action}: {name}", 5,
                 FLEET_USER=user, FLEET_COMMAND=f"secret.{action}", FLEET_SECRET=name)


def fail(message: str) -> None:
    print(f"fleet-secret: {message}", file=sys.stderr)
    sys.exit(1)


def store(directory, name: str, max_size: int) -> None:
    """Encrypt stdin into DIRECTORY/NAME.cred, readable by the service account."""
    value = sys.stdin.buffer.read(max_size + 1)
    if not value:
        fail("empty value")
    if len(value) > max_size:
        fail(f"value larger than {max_size} bytes")
    # No embedded name: the run unit loads it under a per-purpose name.
    result = subprocess.run(
        ["/usr/bin/systemd-creds", "encrypt", "--name=", "-", "-"],
        input=value, capture_output=True, check=False,
    )
    if result.returncode != 0:
        fail(result.stderr.decode(errors="replace").strip() or "encryption failed")

    target = directory / (name + SUFFIX)
    temporary = directory / f".{name}.{os.getpid()}.tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640)
    try:
        with os.fdopen(fd, "wb") as out:
            os.fchown(out.fileno(), 0, directory.stat().st_gid)
            out.write(result.stdout)
        os.replace(temporary, target)
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise


def set_secret(name: str) -> None:
    store(SECRETS_DIR, name, MAX_SIZE)
    log("set", name)


def answer() -> None:
    try:
        waiting = sum(1 for _ in ANSWERS_DIR.iterdir())
    except OSError:
        fail(f"{ANSWERS_DIR} is missing")
    if waiting >= MAX_ANSWERS:
        fail("too many secret answers are waiting for a run")
    name = "a-" + secrets.token_hex(16)
    store(ANSWERS_DIR, name, MAX_ANSWER_SIZE)
    log("answer", name)
    print(name)


def delete_secret(name: str) -> None:
    try:
        (SECRETS_DIR / (name + SUFFIX)).unlink()
    except FileNotFoundError:
        fail(f"no such secret: {name}")
    log("delete", name)


def list_secrets() -> None:
    names = sorted(p.name[: -len(SUFFIX)] for p in SECRETS_DIR.glob("*" + SUFFIX))
    for name in names:
        print(name)


def main(argv: list[str]) -> None:
    if os.geteuid() != 0:
        fail("must run as root")
    try:
        if argv[1:] == ["list"]:
            list_secrets()
        elif argv[1:] == ["answer"]:
            answer()
        elif len(argv) == 3 and argv[1] == "set":
            set_secret(check_id(argv[2], "secret name"))
        elif len(argv) == 3 and argv[1] == "delete":
            delete_secret(check_id(argv[2], "secret name"))
        else:
            fail("usage: fleet-secret set NAME < value | delete NAME | list | answer < value")
    except ValueError as error:
        fail(str(error))


if __name__ == "__main__":
    main(sys.argv)
