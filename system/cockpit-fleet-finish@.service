[Unit]
Description=Record the outcome of Cockpit Fleet run %i
Documentation=https://github.com/lineadicomando/cockpit-fleet

[Service]
Type=oneshot
User=cockpit-fleet
Group=cockpit-fleet
# Not sandboxed like a run: this is the backend itself, which must write the
# database and start the next queued run through sudo.
ExecStart=/usr/libexec/cockpit-fleet/fleetctl run.reconcile
StandardInput=null
StandardOutput=null
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/cockpit-fleet
# fleet-unit, through sudo, copies the ciphertext of the run it starts there.
ReadWritePaths=-/run/cockpit-fleet/creds
ProtectHome=yes
PrivateTmp=yes
