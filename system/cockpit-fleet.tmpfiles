d /var/lib/cockpit-fleet          0750 cockpit-fleet cockpit-fleet -
d /var/lib/cockpit-fleet/runs     0750 cockpit-fleet cockpit-fleet -
d /var/lib/cockpit-fleet/projects 0750 cockpit-fleet cockpit-fleet -

# Encrypted credentials. Root writes them; the service user only reads the
# ciphertext, which nothing but PID 1 can decrypt.
d /etc/cockpit-fleet              0755 root root -
d /etc/cockpit-fleet/secrets      0750 root cockpit-fleet -
