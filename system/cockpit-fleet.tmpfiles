d /var/lib/cockpit-fleet          0750 cockpit-fleet cockpit-fleet -
d /var/lib/cockpit-fleet/runs     0750 cockpit-fleet cockpit-fleet -
d /var/lib/cockpit-fleet/projects 0750 cockpit-fleet cockpit-fleet -
d /var/lib/cockpit-fleet/inventories 0750 cockpit-fleet cockpit-fleet -

# Encrypted credentials. Root writes them; the service user only reads the
# ciphertext, which nothing but PID 1 can decrypt.
d /etc/cockpit-fleet              0755 root root -
d /etc/cockpit-fleet/secrets      0750 root cockpit-fleet -
# Those of notification channels, the only ones cockpit-fleet-notify.service
# has decrypted.
d /etc/cockpit-fleet/secrets/notify 0750 root cockpit-fleet -

# Secret answers to a survey, encrypted, until the run they belong to is
# launched. Root writes them; the service user moves them into the run, which
# is why it may write here. One that no run took is removed after an hour.
d /run/cockpit-fleet              0755 root root -
d /run/cockpit-fleet/answers      0770 root cockpit-fleet 1h

# The ciphertext of a run while it starts, copied by fleet-unit, as root: only
# PID 1 reads it here, and fleet-unit removes it once the run has started.
d /run/cockpit-fleet/creds        0700 root root -
