# Service account that owns projects and history and runs Ansible.
u cockpit-fleet - "Cockpit Fleet" /var/lib/cockpit-fleet /usr/sbin/nologin

# Roles: membership decides what a Cockpit user may do.
g cockpit-fleet-admin -
g cockpit-fleet-operator -
g cockpit-fleet-viewer -

# A right, apart from the roles: approving the runs of templates that need it.
g cockpit-fleet-approver -
